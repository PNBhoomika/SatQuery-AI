# =========================================================================
# OrbitIntel / SatQuery-AI — Frontend Environment Variables
# Member 5 (Frontend Engineer) configuration file.
# Copy this to .env.local and edit as needed.
# =========================================================================

# ── API MODE ─────────────────────────────────────────────────────────────
#
# Set to "true" to use local mock data (no backend required).
# Set to "false" or leave empty to use the real Member 4 FastAPI backend.
#
# MOCK MODE:  VITE_USE_MOCK_API=true
# REAL API:   VITE_USE_MOCK_API=false  (default when running with backend)
#
VITE_USE_MOCK_API=true

# ── BACKEND BASE URL ──────────────────────────────────────────────────────
#
# When VITE_USE_MOCK_API=false, all API calls go to this base URL.
# The Vite dev server proxies /api → this URL automatically (see vite.config.ts).
#
# LOCAL DEV:   VITE_API_BASE_URL=/api         (uses Vite proxy → 127.0.0.1:8000)
# STAGING:     VITE_API_BASE_URL=https://api.orbitintel.staging/api
# PRODUCTION:  VITE_API_BASE_URL=https://api.orbitintel.in/api
#
VITE_API_BASE_URL=/api

# ── OPTIONAL: MapTiler / Mapbox Token (if switching from ESRI/OpenStreetMap) ──
# VITE_MAP_TOKEN=your_token_here
