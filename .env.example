# OrbitIntel / SatQuery-AI - Environment Configuration
# Copy this file to .env and fill in appropriate values.
# ==========================================================

# ── LOCAL DEVELOPMENT (DEFAULT) ───────────────────────────
# Uses local Qdrant in-memory/on-disk storage (no external Qdrant needed).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
VECTOR_DB_TYPE=qdrant
QDRANT_STORAGE_PATH=./data/qdrant_db

# ── QDRANT CLOUD (OPTIONAL — for production deployment) ───
# Leave blank to use local embedded Qdrant (default for SIH demo).
QDRANT_URL=
QDRANT_API_KEY=

# ── FRONTEND SETTINGS ─────────────────────────────────────
# Copy these to frontend/.env for Vite builds:
VITE_USE_MOCK_API=false
VITE_API_BASE_URL=/api
VITE_API_URL=http://127.0.0.1:8000

# ── SATELLITE DATA PROVIDER CREDENTIALS (OPTIONAL) ────────
# Required only when querying real external STAC catalogs.
# COPERNICUS_CLIENT_ID=
# COPERNICUS_CLIENT_SECRET=
# USGS_EROS_API_KEY=
# ISRO_BHUVAN_TOKEN=
