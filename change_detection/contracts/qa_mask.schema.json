{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satquery.ai/schemas/qa_mask.schema.json",
  "title": "QAMaskSchema",
  "description": "Schema for optical/multispectral QA mask specification and decoded pixel flags according to PS §2.2.3 Member 3 contract.",
  "type": "object",
  "required": [
    "qa_version",
    "dtype",
    "bit_flags",
    "decoded_summary"
  ],
  "properties": {
    "qa_version": {
      "type": "string",
      "description": "Semantic versioning of the QA mask format generated by Member 1."
    },
    "dtype": {
      "type": "string",
      "enum": ["uint8"],
      "description": "Raster data type. Must be single-band 8-bit unsigned integer."
    },
    "bit_flags": {
      "type": "object",
      "description": "Standard 8-bit allocation for optical satellite QA masks.",
      "required": [
        "bit_0_valid_data",
        "bit_1_cloud",
        "bit_2_cloud_shadow",
        "bit_3_snow",
        "bit_4_haze",
        "bit_5_water",
        "bit_6_saturated",
        "bit_7_cirrus"
      ],
      "properties": {
        "bit_0_valid_data": {
          "type": "integer",
          "const": 1,
          "description": "Bit 0: 1 = valid sensor acquisition, 0 = no-data / fill."
        },
        "bit_1_cloud": {
          "type": "integer",
          "const": 2,
          "description": "Bit 1: 1 = cloud detected, 0 = clear."
        },
        "bit_2_cloud_shadow": {
          "type": "integer",
          "const": 4,
          "description": "Bit 2: 1 = cloud shadow detected, 0 = clear."
        },
        "bit_3_snow": {
          "type": "integer",
          "const": 8,
          "description": "Bit 3: 1 = snow/ice detected, 0 = no snow."
        },
        "bit_4_haze": {
          "type": "integer",
          "const": 16,
          "description": "Bit 4: 1 = atmospheric aerosol/haze, 0 = clear."
        },
        "bit_5_water": {
          "type": "integer",
          "const": 32,
          "description": "Bit 5: 1 = permanent water body baseline, 0 = land."
        },
        "bit_6_saturated": {
          "type": "integer",
          "const": 64,
          "description": "Bit 6: 1 = detector saturation or blooming, 0 = normal."
        },
        "bit_7_cirrus": {
          "type": "integer",
          "const": 128,
          "description": "Bit 7: 1 = high cirrus cloud, 0 = clear."
        }
      },
      "additionalProperties": false
    },
    "decoded_summary": {
      "type": "object",
      "description": "Aggregate spatial statistics extracted across the tile for fast filtering.",
      "required": [
        "valid_data_fraction",
        "cloud_coverage_fraction",
        "shadow_coverage_fraction",
        "usable_pixel_fraction"
      ],
      "properties": {
        "valid_data_fraction": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "cloud_coverage_fraction": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "shadow_coverage_fraction": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "usable_pixel_fraction": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
