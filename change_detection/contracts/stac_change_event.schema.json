{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satquery.ai/schemas/stac_change_event.schema.json",
  "title": "STACChangeEventSchema",
  "description": "STAC 1.0.0 Item schema representation for detected change events with custom change extension properties.",
  "type": "object",
  "required": [
    "type",
    "stac_version",
    "id",
    "geometry",
    "bbox",
    "properties",
    "links",
    "assets"
  ],
  "properties": {
    "type": {
      "type": "string",
      "const": "Feature"
    },
    "stac_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "stac_extensions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "id": {
      "type": "string",
      "description": "Unique identifier for the change event (e.g., ce_YYYYMMDD_...)."
    },
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Polygon", "MultiPolygon", "Point"]
        },
        "coordinates": {
          "type": "array"
        }
      }
    },
    "bbox": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "properties": {
      "type": "object",
      "required": [
        "datetime",
        "start_datetime",
        "end_datetime",
        "change:type",
        "change:morphology",
        "change:confidence"
      ],
      "properties": {
        "datetime": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "start_datetime": {
          "type": "string",
          "format": "date-time"
        },
        "end_datetime": {
          "type": "string",
          "format": "date-time"
        },
        "change:type": {
          "type": "string",
          "enum": ["construction", "clearance", "water_extent", "road", "unknown"]
        },
        "change:morphology": {
          "type": "string",
          "enum": ["appearance", "disappearance", "expansion", "contraction", "none"]
        },
        "change:confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "change:earliest_supported_date": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "change:area_m2": {
          "type": "number",
          "minimum": 0.0
        },
        "model:name": { "type": "string" },
        "model:version": { "type": "string" },
        "proj:epsg": { "type": ["integer", "null"] }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rel", "href"],
        "properties": {
          "rel": { "type": "string" },
          "href": { "type": "string" },
          "type": { "type": "string" },
          "title": { "type": "string" }
        }
      }
    },
    "assets": {
      "type": "object",
      "required": ["change_mask"],
      "properties": {
        "change_mask": {
          "type": "object",
          "required": ["href", "type"],
          "properties": {
            "href": { "type": "string" },
            "type": {
              "type": "string",
              "enum": ["image/tiff; application=geotiff; profile=cloud-optimized"]
            },
            "title": { "type": "string" },
            "roles": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "t1_source": {
          "type": "object",
          "properties": {
            "href": { "type": "string" },
            "type": { "type": "string" },
            "title": { "type": "string" }
          }
        },
        "t2_source": {
          "type": "object",
          "properties": {
            "href": { "type": "string" },
            "type": { "type": "string" },
            "title": { "type": "string" }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
